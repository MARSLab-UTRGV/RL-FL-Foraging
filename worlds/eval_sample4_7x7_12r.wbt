  camera_height 512
  turretSlot [
    GPS {
      name "gps"
      accuracy 0
    }
    InertialUnit {
      name "inertial_unit"
    }
    Emitter {
      name "phero_emitter"
      range 0.5
      channel 10
    }
    Receiver {
      name "phero_receiver"
      channel 10
      bufferSize 1024
    }
  ]
}

