    }
    Emitter {
      name "phero_emitter"
      range 0.5
      channel 10
    }
    Receiver {
      name "phero_receiver"
      channel 10
      bufferSize 1024
    }
  ]
}

Robot {
  translation 0 0 0
  children [
    Emitter { name "emitter1" channel 1 }
    Receiver { name "receiver1" channel 1 }
    Emitter { name "emitter2" channel 2 }
    Receiver { name "receiver2" channel 2 }
    Emitter { name "emitter3" channel 3 }
    Receiver { name "receiver3" channel 3 }
    Emitter { name "emitter4" channel 4 }
    Receiver { name "receiver4" channel 4 }
  ]
  name "supervisor"
  controller "<extern>"
  supervisor TRUE
}
